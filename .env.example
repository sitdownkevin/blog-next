# No required environment variables for the public marketing pages alone.
# Optional site URL override used by metadata, sitemap, robots, and RSS.
NEXT_PUBLIC_SITE_URL=https://kexu.win

# Cloudflare R2 (S3 API) — required for gallery, blog posts (Markdown), and admin.
# R2 bucket CORS must allow PUT from every site origin you use, e.g.
# http://localhost:3000, https://kexu.win, https://www.kexu.win
# (AllowedHeaders: ["*"], AllowedMethods: GET/PUT/HEAD).
#
# Object layout:
#   posts/{slug}.md          — blog Markdown (read via GetObject; not via CDN)
#   posts/*.(png|jpg|…)      — post images (public via R2_PUBLIC_URL)
#   admin/wallets.json       — SIWE admin allowlist
#   gallery/public/…         — publicly listed on /about/gallery
#   (any other prefix)       — browsable/manageable in /admin/gallery
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SIWE admin session (gallery + /admin). Prefer ADMIN_*; GALLERY_* kept for compat.
ADMIN_SESSION_SECRET=
GALLERY_SESSION_SECRET=

# Bootstrap admin wallet when admin/wallets.json is missing (checksummed address).
ADMIN_BOOTSTRAP_ADDRESS=0x7d7984e2ea378465a0e759df675f9d295e566017
GALLERY_ADMIN_ADDRESS=0x7d7984e2ea378465a0e759df675f9d295e566017
